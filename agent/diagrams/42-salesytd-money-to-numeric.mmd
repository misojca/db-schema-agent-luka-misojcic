        int businessentityid PK
        int territoryid FK
    }

    SALES__SALESTERRITORYHISTORY {
        int businessentityid PK
        int territoryid PK
    }

    PERSON__STATEPROVINCE {
        int stateprovinceid PK
        int territoryid FK
    }

    SALES__SALESTERRITORY ||--o{ SALES__CUSTOMER : "has"
