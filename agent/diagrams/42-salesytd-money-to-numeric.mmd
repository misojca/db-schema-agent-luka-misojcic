    SALES__SALESTERRITORY {
        int territoryid PK
        string name
        string countryregioncode
        string group
        decimal salesytd "Phase 1: numeric (old); Phase 2: numeric(19,4) (new)"
        decimal salesytd_new "Phase 1 only: numeric(19,4) nullable, copied from salesytd"
        decimal saleslastyear
        decimal costytd
        decimal costlastyear
